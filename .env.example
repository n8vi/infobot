MESH_HOST=10.0.0.10
MESH_PORT=5051
GOES_URL=http://10.0.0.10:8097
AIS_URL=http://10.0.0.10:8100/api/ships_full.json
# Hinton is locally routed over 44.31.120.0/24; tar1090 HTTP listener on port 80.
ADSB_URL=http://44.31.120.1/tar1090/data/aircraft.json
AIRCRAFT_MAX_AGE=60
SHIP_MAX_AGE=1800
# Local auto-hashtag region names to recognize on received packets.
REGION_NAMES=mi
REPLY_BYTES=130
REPLY_PARTS=3
TX_GAP=6
USER_COOLDOWN=15
# Used only if a repeater elevation is unavailable (advertisements carry lat/lon).
SAT_ALT_M=200
SAT_TLE_REFRESH_HOURS=12

# Optional additions: existing .env files continue to work unchanged.
# Policies: bare, bang (!), mention (@[infobot]), either (! or mention).
# Quote this value: unquoted # starts a comment in dotenv/shell files.
BOT_CHANNELS='#infobot=bare'
DM_ENABLED=true
# 0 uses 1.2x companion suggested timeout (floor 5s, ceiling 300s).
DM_ACK_TIMEOUT=0
# Retransmissions after the first send; protocol supports attempts 0..3.
DM_RETRIES=3
# Reset destination route to flood after this many unanswered attempts.
DM_FLOOD_AFTER=2
COMMAND_TIMEOUT=45
COMMAND_WORKERS=4
CONVERSATION_LIMIT=32
QUEUE_LIMIT=8
GLOBAL_QUEUE_LIMIT=64
# Flood advert on startup and every four hours; seconds, 0 disables.
ADVERT_INTERVAL=14400

# Web answers use the optional Compose web profile.
SEARXNG_URL=http://searxng:8080
LLAMA_URL=http://10.0.0.10:8080
